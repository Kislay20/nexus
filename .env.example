# ==========================================
# NEXUS GATEWAY - ENVIRONMENT CONFIGURATION
# ==========================================

# --- MODE ---
# 'demo' = uses mock PayPal & scripted agent (Zero credentials needed for Judges)
# 'live' = uses real PayPal Sandbox & Gemini API
NEXUS_MODE=demo

# --- SERVER SETTINGS ---
GATEWAY_PORT=8000
DASHBOARD_PORT=3000
CATALOG_URL=http://localhost:8000

# --- STORAGE & CRYPTO (LEDGER) ---
# Your DB name
NEXUS_DB=nexus_secure.db
# Ed25519 keys for the cryptographically signed hash-chain
LEDGER_PRIVATE_KEY=mock_ed25519_private_key_hex_here
LEDGER_PUBLIC_KEY=mock_ed25519_public_key_hex_here

# --- PAYPAL (Sandbox credentials - used in live mode) ---
PAYPAL_CLIENT_ID=sb-mock-client-id-123
PAYPAL_SECRET=sb-mock-secret-456
PAYPAL_WEBHOOK_ID=WH-MOCK-12345

# --- MERCHANT CONFIGURATION ---
MERCHANT_KEYS={"key1": "secret"}
MERCHANT_PAYEES=["payee1@business.example.com"]

# --- AGENT (AI / MCP) & APPROVAL ---
# Optional in demo mode, required for live Gemini interactions
GEMINI_API_KEY=mock_gemini_api_key_here
AGENT_TOKEN=mock_agent_secure_token
APPROVER_KEY=mock_approver_secret_here

# --- SECURITY FLAGS & API ENDPOINTS ---
STRICT_PAYEE=1
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- WEBAUTHN / PASSKEYS ---
APPROVAL_MODE=passkey
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Nexus Gateway"
WEBAUTHN_ORIGIN=http://localhost:3000
ADMIN_BOOTSTRAP_TOKEN=super_secret_admin_123

# --- TELEGRAM BOT ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here